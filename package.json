{
  "name": "@efficimo/cipher",
  "version": "0.0.0",
  "description": "Cryptographic primitives — AES-256-GCM, PBKDF2, RSA-OAEP, WebAuthn PRF key derivation, observable vault",
  "author": "efficimo",
  "license": "MIT",
  "keywords": [
    "crypto",
    "aes-gcm",
    "pbkdf2",
    "webauthn",
    "prf",
    "cipher",
    "vault",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efficimo/cipher.git"
  },
  "bugs": {
    "url": "https://github.com/efficimo/cipher/issues"
  },
  "homepage": "https://github.com/efficimo/cipher#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./webauthn": {
      "import": {
        "types": "./dist/esm/webauthn.d.ts",
        "default": "./dist/esm/webauthn.js"
      },
      "require": {
        "types": "./dist/cjs/webauthn.d.ts",
        "default": "./dist/cjs/webauthn.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:pkg": "tsc -p tsconfig.esm.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "peerDependencies": {
    "@efficimo/observable": ">=0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@efficimo/observable": "^0.5.1",
    "@types/node": "^25.9.7",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
